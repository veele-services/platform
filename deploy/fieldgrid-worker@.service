[Unit]
Description=Fieldgrid outbox worker trigger (%i)
After=fieldgrid@%i.service

[Service]
Type=oneshot
User=fieldgrid
Group=fieldgrid
WorkingDirectory=/opt/fieldgrid/%i/current
EnvironmentFile=/opt/fieldgrid/%i/shared/runtime.env
ExecStart=/usr/bin/env node worker-client.mjs
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/opt/fieldgrid/%i
