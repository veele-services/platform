staging.fieldgrid.nl, *.staging.fieldgrid.nl {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3301 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# A wildcard certificate requires Caddy's DNS challenge and the matching
	# DNS-provider module. Configure that provider on the VPS; keep its API token
	# outside this repository.
	# tls {
	# 	dns <provider> {env.DNS_API_TOKEN}
	# }
}
