# Operator reference ONLY, for installations using clamav-daemon.socket.
# Do not install blindly or change production. Clearing ListenStream prevents
# retaining a distribution/local TCP listener next to the intended Unix socket.
[Socket]
ListenStream=
ListenStream=/run/clamav/clamd.ctl
SocketUser=clamav
SocketGroup=clamav
SocketMode=0660
