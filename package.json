    "fieldgrid:live-day-map-phase10:check": "node scripts/fieldgrid-live-day-map-phase10-beta-gate.mjs --check && node --test tests/fieldgrid-live-day-map-phase10-beta-gate.test.mjs tests/fieldgrid-live-day-map-phase10-performance.test.mjs",
    "fieldgrid:live-day-map-phase10:strict": "node scripts/fieldgrid-live-day-map-phase10-beta-gate.mjs --strict-evidence && node --test tests/fieldgrid-live-day-map-phase10-beta-gate.test.mjs tests/fieldgrid-live-day-map-phase10-performance.test.mjs",
    "fieldgrid:google-maps-sprint5:check": "node --test tests/fieldgrid-google-maps-sprint5-map-component.test.mjs",
    "fieldgrid:google-maps-sprint12:check": "node --test tests/fieldgrid-google-maps-sprint12-legacy-cleanup.test.mjs",
    "fieldgrid:google-maps-sprint13:check": "node --test tests/fieldgrid-google-maps-sprint13-docs.test.mjs",
    "fieldgrid:google-maps-sprint14:check": "node --test tests/fieldgrid-google-maps-sprint*.test.mjs tests/fieldgrid-personnel-home-address-routing.test.mjs && node scripts/fieldgrid-migration-order-check.mjs --check && node scripts/fieldgrid-google-maps-playwright-smoke.mjs --mock && node scripts/fieldgrid-google-maps-sprint14-acceptance.mjs --check --strict-evidence",
    "fieldgrid:google-maps-sprint14:strict": "pnpm run typecheck && pnpm -r --if-present run build && pnpm fieldgrid:google-maps-sprint14:check",
    "fieldgrid:google-maps-sprint14:staging-live": "node scripts/fieldgrid-google-maps-playwright-smoke.mjs --staging-live",
    "fieldgrid:invoice-sprint10-release-gate": "node scripts/fieldgrid-invoice-sprint10-release-gate.mjs && node --test tests/fieldgrid-invoice-canon-sprint10-release-gate.test.mjs",
    "fieldgrid:invoice-sprint10-release-gate:check": "node scripts/fieldgrid-invoice-sprint10-release-gate.mjs --check && node --test tests/fieldgrid-invoice-canon-sprint10-release-gate.test.mjs",
    "fieldgrid:invoice-sprint10-release-gate:strict": "node scripts/fieldgrid-invoice-sprint10-release-gate.mjs --strict-evidence && node --test tests/fieldgrid-invoice-canon-sprint10-release-gate.test.mjs",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db run db:migrate",
    "db:baseline": "pnpm --filter @workspace/db run db:baseline",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
