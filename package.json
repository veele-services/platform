    "fieldgrid:kb-roadmap-release-phase7:check": "node scripts/fieldgrid-kb-roadmap-release-phase7.mjs --check",
    "fieldgrid:kb-roadmap-release-phase1-security": "node scripts/fieldgrid-kb-roadmap-release-phase1-security.mjs",
    "fieldgrid:kb-roadmap-release-phase1-security:check": "node scripts/fieldgrid-kb-roadmap-release-phase1-security.mjs --check",
