    "fieldgrid:phase5-platform-accelerators:check": "node scripts/fieldgrid-visual-regression-snapshots.mjs --check && node --test tests/fieldgrid-phase-5-platform-accelerators.test.mjs",
    "fieldgrid:platform-admin-final-gate": "node scripts/fieldgrid-platform-admin-final-gate.mjs",
    "fieldgrid:platform-admin-final-gate:check": "node scripts/fieldgrid-platform-admin-final-gate.mjs --check",
    "fieldgrid:platform-admin-final-gate:strict": "node scripts/fieldgrid-platform-admin-final-gate.mjs --strict-evidence",
    "fieldgrid:customer-personnel-final-gate": "node scripts/fieldgrid-customer-personnel-phase16-releasegate.mjs",
    "fieldgrid:customer-personnel-final-gate:check": "node scripts/fieldgrid-customer-personnel-phase16-releasegate.mjs --check",
