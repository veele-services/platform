{
  "name": "fieldgrid",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db && node --test scripts/test-personnel-numbering.mjs scripts/test-planboard.mjs scripts/test-object360.mjs scripts/test-dossier-alignment.mjs scripts/test-travel.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "db:verify-target": "tsx scripts/verify-migration-target.ts",
    "deploy:preflight": "tsx scripts/preflight.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-platform-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.7.1",
    "@mollie/api-client": "4.4.0",
    "@shadcn/react": "0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "7.85.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.7.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "supabase": "2.118.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
