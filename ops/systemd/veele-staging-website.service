[Unit]
Description=Fieldgrid staging website runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=github-runner
Group=veele-deploy
WorkingDirectory=/var/www/veele/website-stack-staging/current
EnvironmentFile=/var/www/veele/website-stack-staging/shared/website.env
Environment=PORT=3305
ExecStart=/usr/bin/env pnpm --filter @workspace/website-runtime run start
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/veele/website-stack-staging
ReadOnlyPaths=/var/www/veele/website-stack-staging/shared/corepack
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
