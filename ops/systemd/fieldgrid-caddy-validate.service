[Unit]
Description=Validate Fieldgrid Caddy configuration with DNS provider
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=caddy
Group=caddy
EnvironmentFile=/etc/caddy/fieldgrid-cloudflare.env
Environment=XDG_DATA_HOME=/var/lib/caddy/.local/share
Environment=XDG_CONFIG_HOME=/var/lib/caddy/.config
ExecStart=/usr/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
