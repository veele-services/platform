[Unit]
Description=Fieldgrid Veele staging marketing website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=github-runner
Group=veele-deploy
WorkingDirectory=/var/www/veele/website-stack-staging/current/artifacts/marketing-website
EnvironmentFile=/var/www/veele/website-stack-staging/shared/marketing.env
Environment=PORT=3306
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node ./node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3306
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/veele/website-stack-staging
ReadOnlyPaths=/var/www/veele/website-stack-staging/shared/corepack
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
