# Fieldgrid WP1 isolated-copy sandbox.
# The helper is installed root-owned at /usr/local/sbin/fieldgrid-wp1-copy-sandbox.
# Sudo authorizes only that fixed root-owned executable. The helper itself
# fail-closes on every argument and accepts only:
#   probe
#   run <numeric-run-id> <numeric-attempt> <reviewed-node-24-path>
# This avoids sudoers argument wildcard incompatibilities on the staging host.
Cmnd_Alias FIELDGRID_WP1_COPY_SANDBOX = \
    /usr/local/sbin/fieldgrid-wp1-copy-sandbox

github-runner ALL=(root) NOPASSWD: FIELDGRID_WP1_COPY_SANDBOX
