# Fieldgrid V1 staging configuration contract.
# Fixed values below are non-secret. Angle-bracket values are placeholders and
# must be supplied through the future GitHub Environment `staging`.

# Deployment identity and public origin
DEPLOY_TARGET=staging
APP_URL=https://staging.fieldgrid.nl
HOSTNAME=127.0.0.1
PORT=3301
LOG_LEVEL=info

# Release layout and validation
DEPLOY_ROOT=/opt/fieldgrid/staging
SERVICE_NAME=fieldgrid@staging.service
HEALTHCHECK_URL=https://staging.fieldgrid.nl/api/healthz
RELEASE_SHA=<exact-40-character-git-sha>

# A deployment environment named staging does not by itself imply that the
# application schema accepts APP_ENV=staging. Set APP_ENV only after validating
# the implementation's accepted values.

# Supabase project isolation
EXPECTED_SUPABASE_PROJECT_REF=<dedicated-staging-project-ref>
FORBIDDEN_SUPABASE_PROJECT_REF=ckdtiuemeygrnujjibnw
NEXT_PUBLIC_SUPABASE_URL=https://<dedicated-staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-publishable-key>
SUPABASE_URL=https://<dedicated-staging-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<staging-server-secret>
MIGRATION_DATABASE_URL=<staging-migration-connection-secret>
BACKUP_DATABASE_URL=<staging-backup-connection-secret>

# SendGrid: use the standard API base unless the account configuration proves
# that a regional endpoint is required.
SENDGRID_API_KEY=<staging-sendgrid-secret>
SENDGRID_FROM_EMAIL=<verified-staging-sender>
SENDGRID_FROM_NAME=Fieldgrid
# SENDGRID_API_BASE=<regional-api-base-only-when-required>

# Push notifications. Supply one stable, staging-only VAPID pair when enabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<required-when-push-is-enabled>
VAPID_PRIVATE_KEY=<staging-vapid-private-secret>
VAPID_SUBJECT=mailto:<managed-contact-address>

# Google Routes is disabled for the first staging deployment.
GOOGLE_ROUTES_ENABLED=false
# GOOGLE_MAPS_SERVER_API_KEY=<required-only-when-routes-is-enabled>
