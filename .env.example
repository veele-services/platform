# Fieldgrid V1 staging configuration contract.
# Fixed values below are non-secret. Angle-bracket values are placeholders for
# entries already held by GitHub Environment `staging`; never copy their real
# values into this file.

# Deployment identity and public origin
DEPLOY_TARGET=staging
APP_ENV=development
APP_URL=https://staging.fieldgrid.nl
HOSTNAME=127.0.0.1
PORT=3301
LOG_LEVEL=info

# Release layout and validation
DEPLOY_ROOT=/opt/fieldgrid/staging
SERVICE_NAME=fieldgrid@staging.service
HEALTHCHECK_URL=https://staging.fieldgrid.nl/api/healthz
RELEASE_SHA=<exact-40-character-git-sha>

# APP_ENV intentionally remains development: the validated application enum
# accepts development/production, while DEPLOY_TARGET identifies staging.

# Supabase project isolation
EXPECTED_SUPABASE_PROJECT_REF=<github-staging-project-ref>
FORBIDDEN_SUPABASE_PROJECT_REF=ckdtiuemeygrnujjibnw
NEXT_PUBLIC_SUPABASE_URL=<github-staging-secret>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<github-staging-secret>
SUPABASE_URL=<derived-from-next-public-supabase-url>
SUPABASE_SERVICE_ROLE_KEY=<github-staging-secret>
DATABASE_URL=<github-staging-secret>
MIGRATION_DATABASE_URL=<github-staging-secret>
BACKUP_DATABASE_URL=<github-staging-secret>

# Runtime and bootstrap secrets
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<github-staging-secret>
ADMIN_API_SECRET=<github-staging-secret>
FIELDGRID_ADMIN_EMAIL=<github-staging-secret>
FIELDGRID_ADMIN_PASSWORD=<github-staging-secret>

# SendGrid: use the standard API base unless the account configuration proves
# that a regional endpoint is required.
SENDGRID_API_KEY=<github-staging-secret>
SENDGRID_FROM_EMAIL=noreply@fieldgrid.nl
SENDGRID_FROM_NAME=Fieldgrid
# SENDGRID_API_BASE=<regional-api-base-only-when-required>
# Configured in GitHub Environment staging; never copy real values here.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=<github-staging-variable>
SUPABASE_SEND_EMAIL_HOOK_SECRET=<github-staging-secret>
MAIL_MARKETING_ENABLED=false

# Payments use a staging-only Mollie credential.
MOLLIE_API_KEY=<github-staging-secret>

# Push notifications. Supply one stable, staging-only VAPID pair when enabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<github-staging-variable>
VAPID_PRIVATE_KEY=<github-staging-secret>
VAPID_SUBJECT=mailto:services@fieldgrid.nl

# Real private attachment scanner. Operator-provisioned Unix socket; no TCP or
# fake-clean fallback. Empty means unavailable and blocks ticket release GO.
CLAMAV_ENABLED=true
CLAMAV_SOCKET=/run/clamav/clamd.ctl
CLAMAV_TIMEOUT_MS=30000
CLAMAV_MAX_DATABASE_AGE_HOURS=72

# Google Routes is disabled for the first staging deployment.
GOOGLE_ROUTES_ENABLED=false
# GOOGLE_MAPS_SERVER_API_KEY=<required-only-when-routes-is-enabled>

# Basic travel times: server-only HeiGIT / openrouteservice credential.
# Add the secret to GitHub Environment staging. Without it, travel is explicitly
# unknown; manual estimates remain available. PDOK and OpenFreeMap need no key.
# OPENROUTESERVICE_API_KEY=<github-staging-secret>
OPENROUTESERVICE_BASE_URL=https://api.heigit.org/openrouteservice/v2
ROUTING_PROVIDER=openrouteservice
ROUTING_CACHE_DAYS=30
# Conservative shared limits; verify against the actual provider subscription.
ROUTING_MATRIX_MINUTE_LIMIT=35
ROUTING_MATRIX_DAY_LIMIT=450
ROUTING_DIRECTIONS_MINUTE_LIMIT=35
ROUTING_DIRECTIONS_DAY_LIMIT=1900
