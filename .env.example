# ==============================================================================
# VEELE SERVICES PLATFORM — Environment Variables
# ==============================================================================
#
# Copy this file to .env (never commit .env to version control).
# On Replit: add secrets via the Secrets tab instead of a .env file.
# On VPS (staging/production): set these as system environment variables or
# in the PM2 ecosystem config.
#
# Legend:
#   [REQUIRED] — app will throw on startup or at first use if missing
#   [OPTIONAL] — has a sensible default; override only when needed
#   [AUTO]     — injected automatically by Replit / artifact.toml / PM2;
#                do NOT set manually in most cases
#
# ==============================================================================


# ── DATABASE ───────────────────────────────────────────────────────────────────
#
# Used by:
#   lib/db/src/index.ts          — Drizzle ORM connection pool (all DB queries)
#   lib/db/drizzle.config.ts     — drizzle-kit push/generate/migrate commands
#   lib/db/src/migrate.ts        — migration runner (db:migrate script)
#
# For Supabase: use the "Session pooler" URI from
#   Supabase Dashboard → Settings → Database → Connection string (URI)
#   Use port 5432 (session mode), not 6543 (transaction mode), because
#   Drizzle uses prepared statements which require session-mode pooling.
#
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
#
# [REQUIRED]
DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"


# ── SUPABASE AUTH + API ────────────────────────────────────────────────────────
#
# All three values come from:
#   Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL
#   Used by:
#     artifacts/backoffice/src/lib/supabase/server.ts   — server-side auth client
#     artifacts/backoffice/src/lib/supabase/client.ts   — browser-side auth client
#     artifacts/backoffice/src/middleware.ts             — Edge middleware session check
#     artifacts/backoffice/src/app/(auth)/login/page.tsx — login page config check
#   Value: "Project URL" in Supabase API settings
#
# [REQUIRED]
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Used by:
#     artifacts/backoffice/src/lib/supabase/server.ts   — server-side auth client
#     artifacts/backoffice/src/lib/supabase/client.ts   — browser-side auth client
#     artifacts/backoffice/src/middleware.ts             — Edge middleware session check
#     artifacts/backoffice/src/app/(auth)/login/page.tsx — login page config check
#   Value: "anon / public" key in Supabase API settings
#   Safe to expose to the browser (enforces RLS; cannot bypass policies).
#
# [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# SUPABASE_SERVICE_ROLE_KEY
#   Used by:
#     Future server-only Supabase admin client (service-role bypasses RLS).
#     Required for admin operations: user management, bulk imports, reporting
#     queries that need to read across all rows regardless of RLS policies.
#   Value: "service_role" key in Supabase API settings
#   NEVER expose to the browser or include in NEXT_PUBLIC_* variables.
#
# [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY="eyJ..."


# ── SESSION / COOKIE SECURITY ──────────────────────────────────────────────────
#
# Used by:
#   artifacts/backoffice/src/lib/auth/session-permissions.ts
#     — HMAC-SHA256 signs the `veele_perms` cookie that caches the user's
#       permissions at login time. The middleware reads this cookie for
#       edge-level RBAC without a database round-trip.
#
# Generate a strong random value (min 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# [REQUIRED]
SESSION_SECRET="change-me-use-at-least-48-random-hex-characters"


# ── APPLICATION METADATA ───────────────────────────────────────────────────────
#
# Used by:
#   artifacts/backoffice/next.config.ts — allowedDevOrigins for Replit proxy
#   General branding / metadata (available to both server and browser via
#   NEXT_PUBLIC_ prefix).
#
# NEXT_PUBLIC_APP_NAME
#   Display name used in page titles and UI.
#
# [OPTIONAL] defaults to "Veele Services"
NEXT_PUBLIC_APP_NAME="Veele Services"

# NEXT_PUBLIC_APP_URL
#   Canonical base URL of the application (no trailing slash).
#   Set to the VPS IP / domain in staging/production.
#   Used for absolute URL construction and OAuth callback configuration.
#
# [OPTIONAL] — set in production to your public domain
NEXT_PUBLIC_APP_URL="https://your-domain.com"


# ── MOLLIE PAYMENTS ───────────────────────────────────────────────────────────
#
# MOLLIE_API_KEY
#   Used by:
#     artifacts/backoffice/src/app/actions/payments.ts — create Mollie payment
#     artifacts/api-server/src/routes/webhooks.ts       — re-verify payment status
#   Get from: Mollie Dashboard → Developers → API keys
#   Use "test_..." for development / staging, "live_..." for production.
#
# [REQUIRED] — payment creation and webhook processing will fail without this
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# MOLLIE_WEBHOOK_SECRET
#   Used by:
#     artifacts/api-server/src/routes/webhooks.ts — verifies x-mollie-signature
#   Generate a strong random value and configure Mollie to send the same HMAC
#   signature header.
#
# [REQUIRED for production webhooks]
MOLLIE_WEBHOOK_SECRET="change-me-use-at-least-32-random-characters"

# MOLLIE_WEBHOOK_URL
#   Used by:
#     artifacts/backoffice/src/app/actions/payments.ts — Mollie webhook callback URL
#   Override only when the auto-detected public URL is wrong.
#   Auto-detected from REPLIT_DOMAINS (production) or REPLIT_DEV_DOMAIN (dev).
#   On VPS: set to "https://your-domain.com/api/webhooks/mollie"
#
# [OPTIONAL] — auto-computed from REPLIT_DOMAINS / REPLIT_DEV_DOMAIN if not set
MOLLIE_WEBHOOK_URL="https://your-domain.com/api/webhooks/mollie"


# ── API SERVER ─────────────────────────────────────────────────────────────────
#
# LOG_LEVEL
#   Used by:
#     artifacts/api-server/src/lib/logger.ts — pino log level
#   Valid values: trace | debug | info | warn | error | fatal
#   Defaults to "info" when not set.
#
# [OPTIONAL] defaults to "info"
LOG_LEVEL="info"

# ADMIN_API_SECRET
#   Used by:
#     artifacts/api-server/src/routes/payment-reminders.ts
#     artifacts/api-server/src/routes/expired-quotes.ts
#   Required bearer token for scheduled admin routes.
#
# [REQUIRED for scheduled jobs]
ADMIN_API_SECRET="change-me-use-at-least-48-random-hex-characters"

# SUPABASE_URL / SUPABASE_JWT_SECRET
#   Used by:
#     artifacts/api-server/src/middleware/auth.ts
#   SUPABASE_URL enables JWKS validation. SUPABASE_JWT_SECRET is an optional
#   fallback if JWKS is unavailable.
#
# [OPTIONAL when NEXT_PUBLIC_SUPABASE_URL is already written as SUPABASE_URL]
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_JWT_SECRET=""

# RESEND_API_KEY / RESEND_FROM_EMAIL
#   Used by API server and PWA email helpers.
#
# [REQUIRED for e-mail delivery]
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Veele <noreply@your-domain.com>"

# SITE_URL / NEXT_PUBLIC_SITE_URL
#   Used for absolute links in transactional e-mails.
#
# [OPTIONAL] defaults are deployment-specific
SITE_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"


# ── AUTO-INJECTED — DO NOT SET MANUALLY ───────────────────────────────────────
#
# These variables are set automatically by Replit's platform or by the
# artifact.toml workflow configuration. You should never need to set them
# yourself in a .env file.
#
# PORT
#   Set by artifact.toml [services.env] for each service:
#     backoffice   → 22138
#     api-server   → 8080
#     mockup-sandbox → 8081
#   Used by Next.js and Express to bind their HTTP listeners.
#
# BASE_PATH
#   Set by artifact.toml for the mockup-sandbox (/__mockup).
#   Used by vite.config.ts (artifacts/mockup-sandbox/vite.config.ts).
#
# NODE_ENV
#   Set to "development" by dev workflow scripts and "production" by the
#   artifact.toml production build/run env blocks.
#   Used by:
#     artifacts/api-server/src/lib/logger.ts  — enables pino-pretty in dev
#     artifacts/backoffice/src/app/actions/auth.ts — sets cookie secure flag
#     artifacts/backoffice/next.config.ts     — enables allowedDevOrigins in dev
#
# REPLIT_DOMAINS
#   Comma-separated list of Replit preview domains for this repl.
#   Used by artifacts/backoffice/next.config.ts to populate allowedDevOrigins.
#   Injected automatically by the Replit platform.
#
# REPL_ID
#   Unique identifier for the Replit workspace.
#   Used by artifacts/mockup-sandbox/vite.config.ts to detect the Replit env.
#   Injected automatically by the Replit platform.
#
# PGDATABASE / PGHOST / PGPORT / PGUSER / PGPASSWORD
#   Raw PostgreSQL connection parameters injected by Replit's managed database.
#   Not used directly by this app (the app uses DATABASE_URL instead), but
#   present in the environment when Replit's built-in Postgres is provisioned.
