{
  "schemaVersion": 1,
  "decisionDate": "2026-07-14",
  "authBackendDecision": "Supabase Auth remains the credential and session backend for now; Fieldgrid owns the application authentication boundary.",
  "fieldgridOwnedControls": [
    "tenant/host resolution",
    "invite orchestration",
    "recovery challenges",
    "reset verification",
    "password policy",
    "rate limits",
    "audit",
    "e-mail delivery",
    "support/admin reset policy",
    "portal cookie isolation",
    "post-login profile resolution"
  ],
  "providerOwnedControls": [
    "credential verification",
    "password hash storage",
    "refresh token issuance",
    "access token issuance",
    "provider session lifecycle primitives"
  ],
  "mandatoryDecisions": {
    "hostOnlyFieldgridAuthCookies": "accepted",
    "noMagicLinksAsCanonicalFlow": "accepted",
    "noTemporaryPasswordByEmail": "accepted",
    "challengeCodeFlow": "accepted",
    "resetGrantFlow": "accepted",
    "sessionRevocationRequirements": "accepted",
    "administratorResetStepUpMfa": "accepted",
    "wrongHostSessionDenial": "accepted",
    "suspendedTenantDenial": "accepted",
    "personnelCustomerProfileUniqueness": "accepted",
    "platformAssuranceLevel": "accepted",
    "csrfSessionCookieModel": "accepted",
    "jwtCustomClaimsNoTenantDependency": "accepted",
    "databaseDerivedTenantIdentity": "accepted",
    "supabaseReplacementMigrationPath": "accepted"
  },
  "runtimeDependencies": [
    {
      "name": "Supabase Auth",
      "status": "current backend",
      "fieldgridAbstractionRequired": true,
      "allowedUses": ["sign-in credential check", "session refresh", "password update", "provider token revocation"],
      "forbiddenUses": ["canonical tenant authorization", "canonical portal selection", "canonical reset e-mail delivery", "canonical invite e-mail delivery"]
    },
    {
      "name": "Fieldgrid tenant database",
      "status": "canonical authority",
      "fieldgridAbstractionRequired": false,
      "allowedUses": ["host to tenant mapping", "profile status", "tenant status", "tenant membership", "audit evidence", "reset challenge and grant state"]
    },
    {
      "name": "Fieldgrid mailer",
      "status": "canonical delivery path",
      "fieldgridAbstractionRequired": true,
      "allowedUses": ["invite code delivery", "recovery challenge delivery", "reset status notifications"]
    }
  ],
  "jwtTenantClaimDependency": "Do not depend on tenant_id JWT claims for personnel tenant binding; derive tenant identity from Fieldgrid host and database records.",
  "resetModel": "Challenge-code verification creates a short-lived reset grant; the grant authorizes password update and is invalidated after use, expiry, rate-limit lockout, profile disablement, tenant suspension, or session revocation.",
  "sessionRevocationRequirement": "Password reset, admin reset, credential compromise, tenant suspension, profile inactivation, wrong-host detection, and support security action must revoke Fieldgrid cookies and provider refresh sessions.",
  "stepUpRequirement": "Administrator and support reset operations require recent step-up/MFA before reset initiation, grant issuance, or session revocation changes."
}
