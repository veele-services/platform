  "evidenceContract": {
    "schemaVersion": 3,
    "sharedIndexContract": "acceptance.json#evidenceContract.indexSchema",
    "claimFields": ["commit", "index"],
    "stateRequirements": {
      "MITIGATED": [
        "commit",
        "index",
        "codePaths+blobSha256",
        "typed risk-bound commands passed with exitCode 0",
        "machine-readable runtime report+sha256+zero failures",
        "verified Git ancestry and successful GitHub Actions provenance"
      ],
      "VERIFIED_LOCAL": [
        "one live independent exact-HEAD APPROVED GitHub review"
      ],
      "VERIFIED_STAGING": [
        "machine-readable staging report+sha256+zero failures",
        "live functional-security exact-HEAD reviewer",
        "live visual-a11y exact-HEAD reviewer"
      ],
      "CLOSED": ["residualRisk in index", "closureDecision in index"]
    }
  },
  "rule": "Risk wording and required closure remain canonical in 10-RISICOREGISTER.md. Every P0/P1 risk must be CLOSED before global promotion; states may not be skipped and every evidence claim uses the hashed, subject-bound index contract from acceptance.json.",
