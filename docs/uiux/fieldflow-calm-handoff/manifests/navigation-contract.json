    "breadcrumb": "Active-item climbing never changes breadcrumbs; breadcrumbs always render the complete exact parent chain ending at the matched route."
  },
  "routeResolutionPolicy": {
    "steps": [
      "Match an exact static route first.",
      "Match a dynamic route pattern from routes.json next; compare matching patterns segment by segment from left to right, where a static segment beats a dynamic segment at the first difference; then the pattern with more segments wins.",
      "Match literal matchPrefixes last; the longest prefix wins.",
      "If specificity is equal, the lower navOrder wins and then the lexicographically lower route id."
