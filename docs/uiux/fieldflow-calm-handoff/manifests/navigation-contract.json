  "activeStatePolicy": {
    "matchedRoute": "Resolve the exact active route with routeResolutionPolicy before selecting a navigation item.",
    "visibleItem": "Starting at the matched route, follow parentId until the first route included by the current consumer after availability filtering. That route alone receives the active navigation state.",
