{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./email-service": "./src/email-service.ts",
    "./email-templates": "./src/email-templates.ts",
    "./events": "./src/events.ts",
    "./address-geocoding": "./src/address-geocoding.ts",
    "./google-places": "./src/google-places.ts",
    "./portal-routes": "./src/portal-routes.ts",
    "./invoice-numbering": "./src/invoice-numbering.ts",
    "./invoice-finalization": "./src/invoice-finalization.ts",
    "./invoice-number-formatting": "./src/invoice-number-formatting.ts",
    "./planning-realtime": "./src/planning-realtime.ts",
    "./workflow-events": "./src/workflow-events.ts",
    "./planning-intelligence": "./src/planning-intelligence.ts",
    "./interest-selection-staffing": "./src/interest-selection-staffing.ts",
    "./staffing-lifecycle": "./src/staffing-lifecycle.ts",
    "./e2e-auth-adapter": "./src/e2e-auth-adapter.ts",
    "./website-public-runtime": "./src/website-public-runtime.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts migrate",
    "db:baseline": "tsx src/migrate.ts baseline",
    "inspect": "node ./scripts/inspect-database.mjs",
    "tenant-hardening:report": "node ./scripts/tenant-hardening-report.mjs",
    "storage-tenancy:report": "node ./scripts/storage-tenancy-report.mjs",
    "seed:rbac": "tsx src/seed/rbac.ts",
    "seed:sectors": "tsx src/seed/sectors.ts",
    "seed:platform-admin": "tsx src/seed/platform-admin.ts",
    "seed:platform-users": "tsx src/seed/platform-users.ts",
    "seed:staging-demo": "tsx src/seed/staging-demo.ts",
    "seed:staging-demo:dry-run": "tsx src/seed/staging-demo.ts --dry-run",
    "seed:all": "tsx src/seed/rbac.ts && tsx src/seed/sectors.ts"
  },
  "dependencies": {
    "@workspace/website-core": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "resend": "^6.12.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  }
}
