APP_ENV="local"
APP_URL="http://localhost:3000"
BASE_PATH=""
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_NAME="Veele Services"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL=""
JWT_SECRET=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SESSION_SECRET=""

# Google Maps Platform
# Browserkey alleen beperken tot Maps JavaScript API en toegestane hosts.
# GitHub may store the browser key as GOOGLE_MAPS_BROWSER_API_KEY; deployment
# maps it to NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY for the Next.js build.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=""
# Serverkey nooit NEXT_PUBLIC maken; uitsluitend server-side voor Places API (New) en Routes API.
GOOGLE_MAPS_SERVER_API_KEY=""
GOOGLE_MAPS_MAP_ID=""
GOOGLE_MAPS_ENABLED="true"
GOOGLE_MAPS_DEFAULT_COUNTRY="NL"
GOOGLE_MAPS_DEFAULT_LANGUAGE="nl"
GOOGLE_MAPS_DEFAULT_REGION="NL"
GOOGLE_PLACES_AUTOCOMPLETE_ENABLED="true"
GOOGLE_ROUTES_ENABLED="true"
GOOGLE_ROUTES_TRAFFIC_ENABLED="true"
