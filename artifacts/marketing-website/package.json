{
  "name": "@workspace/marketing-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "content:verify": "node scripts/verify-content.mjs",
    "test:routes": "node --test tests/route-inventory.test.mjs",
    "test:e2e": "playwright test",
    "test:visual:all": "playwright test tests/e2e/all-routes-visual-layout.spec.ts",
    "visual:contact-sheets": "node scripts/build-visual-contact-sheets.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:lighthouse": "lighthouse http://127.0.0.1:3000 --quiet --chrome-flags='--headless --no-sandbox' --preset=desktop --budget-path=lighthouse-budget.json --output=json --output-path=.lighthouse-report.json && node scripts/verify-lighthouse-report.mjs",
    "check": "pnpm content:verify && pnpm test:routes && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.38.0",
    "lucide-react": "0.545.0",
    "next": "15.5.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.18",
    "lighthouse": "13.4.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
