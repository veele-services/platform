# Public canonical URLs (no secrets)
NEXT_PUBLIC_SITE_URL=https://www.veeleservices.nl
NEXT_PUBLIC_PORTAL_URL=https://portal.veeleservices.nl
# Toon alleen een contactadres nadat dit kanaal is bevestigd; leeg laat de link weg.
NEXT_PUBLIC_CONTACT_EMAIL=

# Fieldgrid custom-delivery staging identity. The health route fails closed
# unless all values are valid and describe the same *.staging.fieldgrid.nl host.
APP_ENV=staging
NEXT_PUBLIC_MARKETING_SITE_URL=https://veele.staging.fieldgrid.nl
FIELDGRID_WEBSITE_FORM_ID=11111111-1111-4111-8111-111111111111
FIELDGRID_CUSTOM_ROUTE_KEY=veele_staging_primary
FIELDGRID_CUSTOM_RELEASE_ID=git-commit:reviewed-exact-staging-sha
FIELDGRID_CUSTOM_EXPECTED_HOST=veele.staging.fieldgrid.nl

# Optional integrations; activate only after consent/privacy review.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_GTM_ID=
