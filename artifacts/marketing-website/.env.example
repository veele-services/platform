# Public canonical URLs (no secrets)
NEXT_PUBLIC_SITE_URL=https://www.veeleservices.nl
NEXT_PUBLIC_PORTAL_URL=https://portal.veeleservices.nl
# Toon alleen een contactadres nadat dit kanaal is bevestigd; leeg laat de link weg.
NEXT_PUBLIC_CONTACT_EMAIL=

# Comma-separated origins that may post forms. Include preview origins explicitly.
FORM_ALLOWED_ORIGINS=https://www.veeleservices.nl

# disabled | webhook | stub
# Keep disabled until the receiving endpoint, DPA, retention and field mapping are approved.
# `stub` accepts submissions only outside production and is intended for local QA.
FORM_DELIVERY_MODE=disabled
FORM_DELIVERY_WEBHOOK_URL=
FORM_DELIVERY_WEBHOOK_SECRET=

# Optional integrations; activate only after consent/privacy review.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_GTM_ID=
