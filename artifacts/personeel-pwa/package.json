{
  "name": "@workspace/personeel-pwa",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p $PORT",
    "build": "next build",
    "cap:add:android": "cap add android",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "android:signing:init": "node ../../scripts/generate-android-upload-keystores.mjs",
    "android:assemble:veele": "pnpm cap:sync && ./android/gradlew -p android assembleVeeleRelease",
    "android:bundle:veele": "pnpm cap:sync && ./android/gradlew -p android bundleVeeleRelease",
    "android:assemble:fieldgrid": "pnpm cap:sync && ./android/gradlew -p android assembleFieldgridRelease",
    "android:bundle:fieldgrid": "pnpm cap:sync && ./android/gradlew -p android bundleFieldgridRelease",
    "android:build:play": "pnpm cap:sync && ./android/gradlew -p android assembleVeeleRelease bundleVeeleRelease assembleFieldgridRelease bundleFieldgridRelease",
    "android:collect:play": "node ../../scripts/collect-android-personnel-artifacts.mjs",
    "android:preflight:runtime": "node ../../scripts/preflight-android-personnel-runtime.mjs --runtime-only",
    "android:preflight:play": "node ../../scripts/preflight-android-personnel-runtime.mjs",
    "start": "next start -H 0.0.0.0 -p $PORT",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@workspace/db": "workspace:*",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "next": "^15.5.0",
    "pg": "^8.20.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "tailwind-merge": "catalog:",
    "zod": "catalog:",
    "@workspace/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  }
}
